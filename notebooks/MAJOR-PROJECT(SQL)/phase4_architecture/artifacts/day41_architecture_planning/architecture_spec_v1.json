  "fusion_module": {
    "name": "Multi-Branch Fusion with Attention",
    "strategy": "concatenation + attention weighting",
    "branch_outputs": [
      128,
      128,
      128
    ],
    "concatenated_dim": 384,
    "attention_heads": 3,
    "layers": [
      {
        "name": "branch_concatenate",
        "type": "Concatenate",
        "input_dims": [
          128,
          128,
          128
        ],
        "output_dim": 384
      },
      {
        "name": "attention_query_dense",
        "type": "Dense",
        "units": 64,
