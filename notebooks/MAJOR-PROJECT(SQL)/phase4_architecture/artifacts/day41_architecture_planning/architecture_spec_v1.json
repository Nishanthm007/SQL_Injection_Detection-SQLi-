  "uncertainty_module": {
    "name": "Uncertainty-Aware Classification Head",
    "strategy": "multi-head prediction + confidence calibration",
    "multi_head_count": 3,
    "heads": [
      {
        "head_id": 0,
        "name": "classifier_head_0",
        "layers": [
          {
            "type": "Dense",
            "units": 128,
            "activation": "relu",
